# Copy to .env and fill in what you need. Everything is optional:
# with nothing set, the app runs fully offline using template (non-AI) drafts.

PORT=3100
# HOST=127.0.0.1          # keep local; only change if you know why
# DATA_DIR=./data         # where db.json is stored

# --- Option A: Claude via the Anthropic API (paid, usage-billed) ---
# Requires `npm install` (installs @anthropic-ai/sdk). Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5   # e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost

# --- Option B: a free LOCAL model via an OpenAI-compatible server (Ollama, LM Studio) ---
# Ollama example:  ollama pull llama3.1  then:
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPAT_MODEL=llama3.1
# OPENAI_COMPAT_API_KEY=     # only if your server needs one
# AI_TIMEOUT_MS=300000

# Optional workspace password (recommended whenever the app is reachable by others, e.g. on Render).
# The /offer page stays public. Set APP_USERNAME to require a specific username (otherwise any username works).
# APP_USERNAME=
# APP_PASSWORD=
