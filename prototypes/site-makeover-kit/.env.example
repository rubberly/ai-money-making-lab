# Copy to .env and fill in only what you need. Everything is optional:
# with an empty .env the app runs fully with template copy and no external services.

# Server
PORT=3200
# HOST=127.0.0.1          # keep local; 0.0.0.0 exposes the app (and your data) to your network
# DATA_DIR=./data

# --- Optional: Claude copy polish (paid API; requires `npm install` for @anthropic-ai/sdk) ---
# Get a key at https://console.anthropic.com/ . Never commit .env.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Optional: a LOCAL model via an OpenAI-compatible server (free; runs on your machine) ---
# Must point at localhost. Examples:
#   Ollama:    OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1   OPENAI_COMPAT_MODEL=llama3.1
#   LM Studio: OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1    OPENAI_COMPAT_MODEL=<loaded model id>
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=

# --- Optional: Google PageSpeed Insights mobile performance score in audits (free key) ---
# https://developers.google.com/speed/docs/insights/v5/get-started
# PAGESPEED_API_KEY=

# Optional workspace password (recommended whenever the app is reachable by others, e.g. on Render).
# The /offer page stays public. Any username works in the browser prompt.
# APP_PASSWORD=
